{
  "name": "http-freekit",
  "version": "1.0.0",
  "description": "Free HTTP(S) debugging, interception & testing toolkit",
  "author": "HTTP FreeKit",
  "type": "module",
  "main": "electron/bootstrap.cjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test",
    "audit": "npm audit --audit-level=high",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "electron": "electron .",
    "generate-icons": "node scripts/generate-icons.js",
    "build:win": "node --no-deprecation ./node_modules/electron-builder/cli.js --win --config electron-builder.config.cjs",
    "build:mac": "node --no-deprecation ./node_modules/electron-builder/cli.js --mac --config electron-builder.config.cjs",
    "build:linux": "node --no-deprecation ./node_modules/electron-builder/cli.js --linux --config electron-builder.config.cjs",
    "build": "node scripts/build.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@phosphor-icons/web": "^2.1.2",
    "electron-updater": "^6.8.9",
    "electron-window-state": "^5.0.3",
    "express": "^5.2.1",
    "https-proxy-agent": "^9.1.0",
    "monaco-editor": "^0.56.0",
    "node-forge": "^1.4.0",
    "pako": "^3.0.1",
    "protobufjs": "^8.7.1",
    "qrcode": "^1.5.4",
    "socks": "^2.8.9",
    "socks-proxy-agent": "^10.1.0",
    "uuid": "^14.0.1",
    "ws": "^8.21.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@electron/asar": "4.2.1",
    "@electron/universal": "3.0.6",
    "@hono/node-server": "2.0.12",
    "dompurify": "^3.4.12",
    "jake": "12.10.1"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.7",
    "sharp": "^0.35.3"
  }
}
